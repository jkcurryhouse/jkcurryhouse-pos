# ---------------------------------------------------------------------------
# JK Curryhouse POS — environment variables
# Local dev: copy to .env (read by both Next.js and the Prisma CLI).
# Amplify:   App settings → Environment variables (amplify.yml copies them into the
#            server runtime at build time).
# ---------------------------------------------------------------------------

# PostgreSQL on RDS (stack jk-curryhouse-db, ap-southeast-2) — endpoint and credentials from
# the stack outputs / Secrets Manager. URL-encode the password. Keep ?sslmode=require: the
# Prisma CLI (migrate/seed) uses it; the app itself uses DATABASE_SSL below.
DATABASE_URL=postgresql://jkadmin:PASSWORD@jk-curryhouse-db.xxxxxxxx.ap-southeast-2.rds.amazonaws.com:5432/jkcurryhouse?sslmode=require

# TLS for the app's connection pool:
#   require = TLS, no CA check (works out of the box)
#   verify  = TLS + verify against the Amazon RDS CA — put the bundle at certs/rds-global-bundle.pem
#             (https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem) or paste it in DATABASE_SSL_CA
#   disable = local Postgres only
DATABASE_SSL=require
# DATABASE_SSL_CA=
# Connections per server instance (keep small on Amplify's serverless runtime)
DATABASE_POOL_MAX=3

# Signs session cookies and manager-approval tokens. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Restaurant network allow-list: comma-separated IPv4 / CIDR / exact IPv6.
# Empty = no restriction (development only). The detected address is shown at
# Admin → Settings → Network and on the "Access blocked" page.
POS_ALLOWED_IPS=
# Trusted proxies that append to X-Forwarded-For after CloudFront (normally 0).
POS_TRUSTED_PROXY_HOPS=0

# Shows the "simulate website order" button on the KDS. Off in production.
ENABLE_DEMO_TOOLS=false

# Leave as-is unless you run a second site from the same database.
RESTAURANT_ID=anand-main

# First-deploy seed only: create your real admin instead of the demo accounts.
# SEED_ADMIN_EMAIL=owner@jkcurryhouse.co.uk
# SEED_ADMIN_NAME=Owner Name
# SEED_ADMIN_PASSWORD=a-long-temporary-passphrase   (must be changed at first sign-in)
